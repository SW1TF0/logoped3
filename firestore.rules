rules_version = '2';
// Security rules for the speech-therapist site (SmartMenuKJ).
// Paste into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validTime(t) {
      return t is string && t.matches('^[0-9]{2}:[0-9]{2}$');
    }
    // Date must be today or later and at most 200 days ahead.
    function reasonableDate(d) {
      let p = d.split('-');
      let day = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return day + duration.value(1, 'd') > request.time
        && day < request.time + duration.value(200, 'd');
    }
    function slotKey(d, t) {
      return d + '_' + t.replace(':', '-');
    }

    // ---------- admins (create manually in the console) ----------
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- settings (public schedule) ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- bookings (PRIVATE personal data) ----------
    // Visitors can only create a pending booking together with its slot marker.
    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['name','phone','email','service','forWhom','note','date','time','slotId','status','createdAt','consent'])
        && request.resource.data.keys().hasAll(['name','phone','date','time','slotId','status','createdAt','consent'])
        && str(request.resource.data.name, 2, 80)
        && str(request.resource.data.phone, 6, 30)
        && (!('email' in request.resource.data) || str(request.resource.data.email, 0, 120))
        && (!('note' in request.resource.data) || str(request.resource.data.note, 0, 500))
        && (!('service' in request.resource.data) || str(request.resource.data.service, 0, 120))
        && (!('forWhom' in request.resource.data) || str(request.resource.data.forWhom, 0, 30))
        && validDate(request.resource.data.date)
        && validTime(request.resource.data.time)
        && reasonableDate(request.resource.data.date)
        && request.resource.data.slotId == slotKey(request.resource.data.date, request.resource.data.time)
        && request.resource.data.status == 'pending'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.bookingId == bookingId
      );
    }

    // ---------- slots (PUBLIC, anonymous "this time is taken" markers) ----------
    // A slot can only be created once, so two people can never book the same time.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['date','time','bookingId','createdAt'])
        && validDate(request.resource.data.date)
        && validTime(request.resource.data.time)
        && slotId == slotKey(request.resource.data.date, request.resource.data.time)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
      );
      allow update, delete: if isAdmin();
    }

    // ---------- reviews (moderated) ----------
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','rating','text','status','createdAt','consent'])
        && str(request.resource.data.name, 2, 60)
        && str(request.resource.data.text, 10, 800)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.status == 'pending'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ---------- articles ----------
    match /articles/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
